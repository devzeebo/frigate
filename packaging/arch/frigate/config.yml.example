# Minimal NVIDIA GPU example for Arch / LXC installs.
# Copy to /config/config.yml and adjust cameras / model path.

mqtt:
  enabled: false

ffmpeg:
  # System ffmpeg (repo package is fine; ffmpeg-full only if you need extra codecs)
  path: /usr
  hwaccel_args: preset-nvidia

detectors:
  onnx:
    type: onnx

model:
  model_type: yolo-generic
  width: 320
  height: 320
  input_tensor: nchw
  input_dtype: float
  path: /config/model_cache/yolov9-t-320.onnx

cameras:
