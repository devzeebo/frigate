  "set-misc-nginx-module-0.33.tar.gz::https://github.com/openresty/set-misc-nginx-module/archive/refs/tags/v0.33.tar.gz"
  "tempio_amd64::https://github.com/home-assistant/tempio/releases/download/2021.09.0/tempio_amd64"
