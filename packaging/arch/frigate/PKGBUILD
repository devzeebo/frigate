  "nginx-1.27.4.tar.gz::https://nginx.org/download/nginx-1.27.4.tar.gz"
  "nginx-vod-module-1.31.tar.gz::https://github.com/kaltura/nginx-vod-module/archive/refs/tags/1.31.tar.gz"
  "nginx-secure-token-module-1.5.tar.gz::https://github.com/kaltura/nginx-secure-token-module/archive/refs/tags/1.5.tar.gz"
