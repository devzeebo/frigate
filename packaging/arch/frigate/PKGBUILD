prepare() {
  # Raise vod MAX_CLIPS and apply Frigate rbsp patch (from docker/main/build_nginx.sh)
  sed -i 's/MAX_CLIPS (128)/MAX_CLIPS (1080)/g' \
    "${srcdir}/nginx-vod-module-1.31/vod/media_set.h"
  patch -d "${srcdir}/nginx-vod-module-1.31" -p1 < "${srcdir}/nginx-vod-rbsp.patch"
}

build() {
  export PATH="/usr/lib/ccache/bin:${PATH}"

  # --- nginx + vod ---
  cd "${srcdir}/nginx-1.27.4"
  ./configure \
    --prefix=/usr/local/nginx \
    --with-file-aio \
    --with-http_sub_module \
    --with-http_ssl_module \
    --with-http_v2_module \
    --with-http_auth_request_module \
    --with-http_realip_module \
    --with-threads \
    --add-module="${srcdir}/ngx_devel_kit-0.3.3" \
    --add-module="${srcdir}/set-misc-nginx-module-0.33" \
    --add-module="${srcdir}/nginx-vod-module-1.31" \
    --add-module="${srcdir}/nginx-secure-token-module-1.5" \
    --with-cc-opt='-O3 -Wno-error=implicit-fallthrough'
  make -j"$(nproc)"

  # --- Frigate web UI (nvm Node 20 from build user home) ---
  export NVM_DIR="${HOME}/.nvm"
  # shellcheck disable=SC1091
  source /usr/share/nvm/init-nvm.sh
  nvm install 20
  nvm use 20

  cd "${srcdir}/frigate-${pkgver}/web"
  npm ci
  npm run build
  mkdir -p dist/assets
  if [[ -d dist/BASE_PATH/monacoeditorwork ]]; then
    mv dist/BASE_PATH/monacoeditorwork/* dist/assets/ || true
    rm -rf dist/BASE_PATH
  fi

  # --- Python venv via uv (all deps from pip, including CUDA ORT) ---
  cd "${srcdir}/frigate-${pkgver}"
  uv venv "${srcdir}/frigate-venv"
  local venv_python="${srcdir}/frigate-venv/bin/python"
  uv pip install --python "${venv_python}" -r "${srcdir}/requirements-arch.txt"
  # Transitive deps may pull CPU onnxruntime; force the CUDA build last
  uv pip uninstall --python "${venv_python}" onnxruntime onnxruntime-gpu \
    2>/dev/null || true
  uv pip install --python "${venv_python}" \
    --extra-index-url https://pypi.nvidia.com \
    'onnxruntime-gpu==1.24.*'
}

package_frigate-nginx() {
  pkgdesc='Frigate custom nginx with vod / secure-token / set-misc modules'
  depends=('openssl' 'pcre2' 'zlib')
  provides=('frigate-nginx')

  cd "${srcdir}/nginx-1.27.4"
  make DESTDIR="${pkgdir}" install
  rm -rf "${pkgdir}/usr/local/nginx/html"
  # Frigate package owns conf/templates; keep mime.types for include
  find "${pkgdir}/usr/local/nginx/conf" -mindepth 1 -maxdepth 1 ! -name 'mime.types' -exec rm -rf {} +
  rm -f "${pkgdir}/usr/local/nginx/conf/"*.default

  install -Dm644 "${srcdir}/frigate-nginx.service" \
    "${pkgdir}/usr/lib/systemd/system/frigate-nginx.service"
  install -Dm755 "${srcdir}/frigate-nginx-start.sh" \
    "${pkgdir}/usr/lib/frigate/frigate-nginx-start.sh"

  # tempio for conf template rendering (used by start script)
  install -Dm755 "${srcdir}/tempio_amd64" "${pkgdir}/usr/local/tempio/bin/tempio"
}

package_frigate() {
  pkgdesc='NVR with realtime local object detection for IP cameras (Arch / NVIDIA)'
  depends=(
    frigate-nginx
    go2rtc
    ffmpeg
    python
    nvidia-utils
    openssl
  )
  optdepends=(
    'ffmpeg-full: AUR build with full codec/CUDA support (recommended)'
    'ffmpeg-cuda-full: alternate AUR ffmpeg with CUDA'
  )
  install=frigate.install
  backup=()

  local src="${srcdir}/frigate-${pkgver}"
  local opt="${pkgdir}/opt/frigate"

  install -dm755 "${opt}"
  cp -a "${src}/frigate" "${opt}/"
  cp -a "${src}/migrations" "${opt}/"
  install -dm755 "${opt}/web"
  cp -a "${src}/web/dist/." "${opt}/web/"
  install -Dm644 "${src}/LICENSE" "${opt}/LICENSE"
  install -Dm644 "${src}/labelmap.txt" "${pkgdir}/labelmap.txt"
  install -Dm644 "${src}/audio-labelmap.txt" "${pkgdir}/audio-labelmap.txt"

  # venv
  cp -a "${srcdir}/frigate-venv" "${opt}/.venv"
  # Rewrite venv shebangs / paths to install location
  local venv="${opt}/.venv"
  sed -i "s|${srcdir}/frigate-venv|/opt/frigate/.venv|g" "${venv}/bin/"* 2>/dev/null || true
  # virtualenv.cfg / pyvenv.cfg
  if [[ -f "${venv}/pyvenv.cfg" ]]; then
    sed -i "s|${srcdir}/frigate-venv|/opt/frigate/.venv|g" "${venv}/pyvenv.cfg"
  fi

  # Helpers used by go2rtc / nginx start scripts (0.17.x layout)
  install -Dm644 "${src}/docker/main/rootfs/usr/local/go2rtc/create_config.py" \
    "${pkgdir}/usr/local/go2rtc/create_config.py"
  install -Dm644 "${src}/docker/main/rootfs/usr/local/ffmpeg/get_ffmpeg_path.py" \
    "${pkgdir}/usr/local/ffmpeg/get_ffmpeg_path.py"
  install -dm755 "${pkgdir}/usr/local/nginx/conf" "${pkgdir}/usr/local/nginx/templates"
  cp -a "${src}/docker/main/rootfs/usr/local/nginx/conf/." "${pkgdir}/usr/local/nginx/conf/"
  cp -a "${src}/docker/main/rootfs/usr/local/nginx/templates/." "${pkgdir}/usr/local/nginx/templates/"
  # 0.17.x helpers (and optionally newer combined helper if present in the tree)
  for helper in get_base_path.py get_listen_settings.py get_nginx_settings.py; do
    if [[ -f "${src}/docker/main/rootfs/usr/local/nginx/${helper}" ]]; then
      install -Dm644 "${src}/docker/main/rootfs/usr/local/nginx/${helper}" \
        "${pkgdir}/usr/local/nginx/${helper}"
    fi
  done
  # Extra labelmaps shipped under rootfs in some releases
  if [[ -d "${src}/docker/main/rootfs/labelmap" ]]; then
    install -dm755 "${pkgdir}/labelmap"
    cp -a "${src}/docker/main/rootfs/labelmap/." "${pkgdir}/labelmap/"
  fi
  # Point Frigate default ffmpeg layout at system binaries
  install -dm755 "${pkgdir}/usr/lib/ffmpeg/system/bin"
  ln -sf /usr/bin/ffmpeg "${pkgdir}/usr/lib/ffmpeg/system/bin/ffmpeg"
  ln -sf /usr/bin/ffprobe "${pkgdir}/usr/lib/ffmpeg/system/bin/ffprobe"

  install -Dm755 "${srcdir}/go2rtc-frigate.sh" \
    "${pkgdir}/usr/lib/frigate/go2rtc-frigate.sh"
  install -Dm644 "${srcdir}/frigate.service" \
    "${pkgdir}/usr/lib/systemd/system/frigate.service"
  install -Dm644 "${srcdir}/go2rtc-frigate.service" \
    "${pkgdir}/usr/lib/systemd/system/go2rtc-frigate.service"
  install -Dm644 "${srcdir}/frigate.tmpfiles" \
    "${pkgdir}/usr/lib/tmpfiles.d/frigate.conf"
  install -Dm644 "${srcdir}/frigate.sysusers" \
    "${pkgdir}/usr/lib/sysusers.d/frigate.conf"
  install -Dm644 "${srcdir}/config.yml.example" \
    "${pkgdir}/usr/share/frigate/config.yml.example"
  install -Dm644 "${srcdir}/README.md" \
    "${pkgdir}/usr/share/doc/frigate/README.md"
}
